# Copy this file to .env and fill in real values before running the app.

# Postgres — on Vercel use the Supabase POOLER URL (port 6543), not db.*:5432
# Example:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true&pgbouncer=true"
DATABASE_URL="postgresql://visamile:visamile_dev_password@localhost:5434/visamile?schema=public"

# Secret used to sign session JWTs — generate a long random value for real use:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-before-deploying"

# Field-level encryption for passport numbers (32+ chars recommended):
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# Public base URL for password-reset links and PayU callbacks
APP_BASE_URL="http://localhost:3000"

# --- Payment gateway (PayU) ---
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""
PAYU_SANDBOX="true"

# --- Notifications (Resend) ---
# Replace re_xxxxxxxxx with your real API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxx"
# Legacy alias still supported by the app:
NOTIFY_EMAIL_API_KEY=""
# Use onboarding@resend.dev until you verify your own domain
NOTIFY_EMAIL_FROM="onboarding@resend.dev"
NOTIFY_EMAIL_WEBHOOK_URL=""
NOTIFY_SMS_API_KEY=""
NOTIFY_WHATSAPP_API_KEY=""

# --- File storage ---
# Prefer Supabase Storage on Vercel (create a private bucket named "documents"):
#   Storage → New bucket → name: documents → Private
STORAGE_DRIVER="supabase"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"
# Fallbacks: local (dev only) | blob (BLOB_READ_WRITE_TOKEN) | s3
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Optional external malware scan hook (POST raw bytes, must return 2xx)
DOCUMENT_SCAN_URL=""
