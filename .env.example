# Copy this file to .env and fill in real values before running the app.

# Postgres connection string (matches docker-compose.yml — host port 5434)
DATABASE_URL="postgresql://visamile:visamile_dev_password@localhost:5434/visamile?schema=public"

# Secret used to sign session JWTs — generate a long random value for real use:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-before-deploying"

# Field-level encryption for passport numbers (32+ chars recommended):
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# Public base URL for password-reset links and PayU callbacks
APP_BASE_URL="http://localhost:3000"

# --- Payment gateway (PayU) ---
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""
PAYU_SANDBOX="true"

# --- Notifications ---
# Resend: set NOTIFY_EMAIL_API_KEY=re_...
# Or generic webhook:
NOTIFY_EMAIL_API_KEY=""
NOTIFY_EMAIL_FROM="noreply@visamile.test"
NOTIFY_EMAIL_WEBHOOK_URL=""
NOTIFY_SMS_API_KEY=""
NOTIFY_WHATSAPP_API_KEY=""

# --- File storage ---
# local (default) or s3
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Optional external malware scan hook (POST raw bytes, must return 2xx)
DOCUMENT_SCAN_URL=""
